# Copy this file to server/.env for local Microsoft 365 testing. Never commit server/.env.

# Microsoft Entra ID and MCP authorization
WORK_OVERVIEW_ENTRA_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
WORK_OVERVIEW_ENTRA_AUDIENCE=<app-client-id>
WORK_OVERVIEW_ENTRA_SCOPE=https://localhost:8080/mcp/access_as_user
WORK_OVERVIEW_ENTRA_TENANT_ID=<tenant-id>
WORK_OVERVIEW_ENTRA_CLIENT_ID=<app-client-id>
WORK_OVERVIEW_ENTRA_CLIENT_SECRET=<client-secret-value>

# MCP endpoint
WORK_OVERVIEW_MCP_RESOURCE_URI=https://localhost:8080/mcp
WORK_OVERVIEW_MCP_URL=https://localhost:8080/mcp

# Local HTTPS
WORK_OVERVIEW_SERVER_SSL_ENABLED=true
WORK_OVERVIEW_SERVER_SSL_KEY_STORE=file:./.local-tls/localhost.p12
WORK_OVERVIEW_SERVER_SSL_KEY_STORE_PASSWORD=local-development-only

# Local database
WORK_OVERVIEW_DATABASE_URL=jdbc:postgresql://localhost:5432/work_overview_agent

# Server
SERVER_PORT=8080

# Optional: shared password for disposable sandbox test accounts, used by Clear Data
# to sign in as message authors and remove their Teams messages.
WORK_OVERVIEW_TEST_USER_PASSWORD=<shared-test-account-password>
